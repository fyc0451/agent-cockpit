# Cockpit Next N0 development profile. No secrets belong in this file.
COCKPIT_NEXT_PROFILE=1
COCKPIT_NEXT_WORKTREE=${HOME}/github/agent-cockpit-next
COCKPIT_PROJECT_ROOT=${HOME}/github
COCKPIT_HOST=127.0.0.1
COCKPIT_PORT=18790
COCKPIT_DATA_DIR=${HOME}/.local/share/agent-cockpit-next-data
COCKPIT_CONFIG_DIR=${HOME}/.config/agent-cockpit-next
COCKPIT_STATE_DIR=${HOME}/.local/state/agent-cockpit-next
COCKPIT_UPLOADS_DIR=${HOME}/.local/share/agent-cockpit-next-uploads
COCKPIT_COORDINATION_DB=${HOME}/.local/share/agent-cockpit-next-data/coordination.sqlite3
COCKPIT_LAUNCH_DESCRIPTORS_PATH=${HOME}/.local/share/agent-cockpit-next-data/launch-descriptors.json
AGENT_COCKPIT_RELEASE_STATE_DIR=${HOME}/.local/state/agent-cockpit-next/release-lane
AGENT_MAIL_PROJECT=${HOME}/github/agent-cockpit-next
HERDR_SESSION=github-agent-cockpit-next
COCKPIT_SYSTEMD_UNIT=agent-cockpit-next.service
COCKPIT_UPGRADE_V2_ENABLED=0
COCKPIT_B0_MODE=off
COCKPIT_HERDR_STATE_MODE=off
COCKPIT_EDITION=source
XDG_DATA_HOME=${HOME}/.local/share/agent-cockpit-next-data
XDG_CONFIG_HOME=${HOME}/.config/agent-cockpit-next
XDG_STATE_HOME=${HOME}/.local/state/agent-cockpit-next
HERDR_CONFIG_PATH=${HOME}/.config/agent-cockpit-next/herdr/config.toml
AGENT_MAIL_DB_PATH=${HOME}/mcp_agent_mail/storage.sqlite3
TEAM_HUB_URL=http://127.0.0.1:8765
HUMAN_AUTH_URL=http://127.0.0.1:8766
