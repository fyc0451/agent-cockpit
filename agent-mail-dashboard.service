[Unit]
Description=Agent Mail Dashboard (FastAPI :8790)
After=network.target agent-mail.service

[Service]
Type=simple
# Cockpit 会启动独立的 Herdr server/agent；发布时只替换主进程，保留 session。
KillMode=process
WorkingDirectory=%h/agent-cockpit
ExecStart=%h/agent-cockpit/.venv/bin/python server.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-%h/agent-cockpit/.env
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
