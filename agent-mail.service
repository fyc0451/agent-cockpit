[Unit]
Description=MCP Agent Mail local hub (Agent Cockpit)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/env "__INSTALL_EXEC_DIR__/agent-mail-run.sh" "__REPO_EXEC_DIR__" "__CLIENT_ENV_EXEC__"
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
