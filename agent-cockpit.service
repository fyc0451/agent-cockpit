[Unit]
Description=Agent Cockpit (FastAPI :8790)
After=network.target agent-mail.service

[Service]
Type=simple
# Cockpit 会启动独立的 Herdr server/agent；发布时只替换主进程，保留 Herdr session。
KillMode=process
WorkingDirectory=%h/agent-cockpit
ExecStart=%h/agent-cockpit/.venv/bin/python server.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-%h/agent-cockpit/.env
NoNewPrivileges=true
UMask=0077

[Install]
# 若要在用户登出后继续运行，请先执行: loginctl enable-linger $USER
WantedBy=default.target
