# agent-cockpit 配置示例
# 复制为 .env 并填入实际值(systemd 部署时用 EnvironmentFile= 或 source)

# ── 服务监听 ──
COCKPIT_HOST=0.0.0.0
COCKPIT_PORT=8790

# ── 外部二进制(留空则自动从 PATH 探测) ──
# HERDR_BIN=/home/you/.local/bin/herdr
# CODEX_BIN=/home/you/.npm-global/bin/codex

# ── hub 连接(Agent Mail,写操作走这里) ──
# hub 地址默认 http://127.0.0.1:8765
# token 从 ~/.agent-mail/client.env 自动读取,无需在此配置
