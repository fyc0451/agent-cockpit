# agent-cockpit 配置示例
# 复制为 .env 并填入实际值(systemd 部署时用 EnvironmentFile= 或 source)

# ── 服务监听 ──
COCKPIT_HOST=127.0.0.1
COCKPIT_PORT=8790

# 监听非本机地址或经反向代理/Tailscale Serve 暴露时设置。
# 生成: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# COCKPIT_TOKEN=replace-with-a-random-token

# ── 外部二进制(留空则自动从 PATH 探测) ──
# HERDR_BIN=/home/you/.local/bin/herdr
# CODEX_BIN=/home/you/.npm-global/bin/codex

# ── Herdr 实时状态源(默认 off) ──
# off:沿用 CLI snapshot；canary:仅指定 session 使用 socket cache；on:全部启用。
# canary 必须同时设置非空 session 列表；回滚只需把 mode 改回 off 并重启。
# COCKPIT_HERDR_STATE_MODE=off
# COCKPIT_HERDR_STATE_CANARY_SESSIONS=github-agent-cockpit

# ── 远程 Hub 连接 ──
# 本地 Agent Mail Hub 仍由 ~/.agent-mail/client.env 管理。
# Team Hub 与 Human issuer 在 Cockpit「设置 → 团队 Hub 连接」中直接配置并持久化；
# SSH 本地转发可使用 loopback HTTP，远端直连必须使用 HTTPS，无需修改 .env。
# Team 群组不读取本机 Agent Mail 数据库或项目路径。
# Agent Mail 数据库自动探测 ~/.local/share/mcp_agent_mail 和旧版 ~/mcp_agent_mail。
# AGENT_MAIL_DB_PATH=/custom/path/storage.sqlite3

# ── Web Push(默认自动生成密钥到 ~/dashboard-data,无需配置) ──
# 仅在多实例共用订阅时手动设置下面两项；二者必须成对出现。
# COCKPIT_VAPID_PRIVATE_KEY=/path/to/vapid-private.pem
# COCKPIT_VAPID_PUBLIC_KEY=base64url-public-key
# COCKPIT_VAPID_SUBJECT=mailto:you@example.com
