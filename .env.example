# agent-cockpit 配置示例
# 复制为 .env 并填入实际值(systemd 部署时用 EnvironmentFile= 或 source)

# ── 服务监听 ──
COCKPIT_HOST=127.0.0.1
COCKPIT_PORT=8790

# 监听非本机地址或经反向代理/Tailscale Serve 暴露时设置。
# 生成: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# COCKPIT_TOKEN=replace-with-a-random-token

# ── 外部二进制(留空则自动从 PATH 探测) ──
# HERDR_BIN=/home/you/.local/bin/herdr
# CODEX_BIN=/home/you/.npm-global/bin/codex

# ── hub 连接(Agent Mail,写操作走这里) ──
# hub 地址默认 http://127.0.0.1:8765
# token 从 ~/.agent-mail/client.env 自动读取,无需在此配置

# ── Web Push(默认自动生成密钥到 ~/dashboard-data,无需配置) ──
# 仅在多实例共用订阅时手动设置下面两项；二者必须成对出现。
# COCKPIT_VAPID_PRIVATE_KEY=/path/to/vapid-private.pem
# COCKPIT_VAPID_PUBLIC_KEY=base64url-public-key
# COCKPIT_VAPID_SUBJECT=mailto:you@example.com
